# Build context excludes — keep the image small
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.git/
.gitignore

# Never copy host node_modules into Docker context
node_modules/
web/frontend/node_modules/
npm-debug.log*

# Large runtime artifacts (mount these instead)
work/
runs/
data/sltealeaf_v5/
data/field_images/

# Model checkpoints & exports (produced at runtime)
*.keras
*.tflite

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Notebook checkpoints
*.ipynb_checkpoints/
.ipynb_checkpoints/

# Docker itself
Dockerfile
docker-compose*.yml
.dockerignore
